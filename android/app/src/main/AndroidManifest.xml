<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" >
  <!-- Deliberately NOT declared: INTERNET. Nothing here makes a network
       call, and the app should not be able to. Inherited from the
       love-android template and removed. -->
  <uses-permission android:name="android.permission.VIBRATE" />
  <uses-permission android:name="android.permission.BLUETOOTH" />
  <!-- Stripped by the noRecord flavour; declared so the flavour has a node
       to remove. The shipped APK carries no microphone permission. -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />

  <!-- OpenGL ES 2.0 -->
  <uses-feature android:glEsVersion="0x00020000" />
  <!-- Touchscreen support -->
  <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
  <!-- Game controller support -->
  <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
  <uses-feature android:name="android.hardware.gamepad" android:required="false" />
  <uses-feature android:name="android.hardware.usb.host" android:required="false" />
  <!-- External mouse input events -->
  <uses-feature android:name="android.hardware.type.pc" android:required="false" />
  <!-- Low latency audio -->
  <uses-feature android:name="android.hardware.audio.low_latency" android:required="false" />
  <uses-feature android:name="android.hardware.audio.pro" android:required="false" />

  <application
      android:allowBackup="false"
      android:icon="${ICON}"
      android:label="${NAME}" >
    <!-- balatro-dualscreen-thor: our subclass, not love-android's GameActivity.
         It inherits everything about running the game and adds only the
         secondary-display companion. See BalatroActivity.java. -->
    <!-- The launcher is the SETUP screen, not the game. On every launch it
         checks for a game (embedded in dev builds, assembled on device in
         release builds), forwards to BalatroActivity when one exists, and
         otherwise walks the user through providing their own Balatro copy.
         The release APK ships no Balatro whatsoever. -->
    <activity
        android:name="com.balatro.dualscreen.SetupActivity"
        android:exported="true"
        android:label="${NAME}"
        android:theme="@android:style/Theme.Material.NoActionBar" >
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
        <category android:name="tv.ouya.intent.category.GAME" />
      </intent-filter>
    </activity>

    <activity
        android:name="com.balatro.dualscreen.BalatroActivity"
        android:exported="true"
        android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
        android:label="${NAME}"
        android:launchMode="singleInstance"
        android:screenOrientation="${ORIENTATION}"
        android:resizeableActivity="false"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen" >
      <intent-filter>
        <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
      </intent-filter>
    </activity>
  </application>
</manifest>
